STORAGE_BACKEND=sqlite
SQLITE_PATH=digest_engine.db
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional. No key means extractive summaries; never silently use a paid provider.
GEMINI_API_KEY=
# Set a currently available free-tier text model before enabling Gemini.
GEMINI_MODEL=
MAX_ARTICLES_PER_RUN=20
MAX_ENTRIES_PER_FEED=5
MAX_AI_CALLS_PER_RUN=20
FEEDS_PATH=config/feeds.json
OUTPUT_DIR=digests
APP_TIMEZONE=Asia/Kolkata
